              "raw": "{\n  \"establecimiento_id\": \"{{establecimientoId}}\",\n  \"ambito\": \"{{ambito}}\",\n  \"tarea_ids\": [\"{{tareaId}}\", \"{{tareaId}}\"]\n}"
            }
          }
        }
