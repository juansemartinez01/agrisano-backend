    {
      "name": "Reordenamiento",
      "item": [
        {
          "name": "Refrescar tablero antes de reordenar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tablero cargado', function () {",
                  "  pm.response.to.be.success;",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const activas = (json.data || []).filter(function (t) {",
                  "  return t.estado === 'pendiente' || t.estado === 'en_progreso';",
                  "});",
                  "const ids = activas.map(function (t) { return t.id; });",
                  "pm.collectionVariables.set('tareaIdsJson', JSON.stringify(ids));",
                  "pm.collectionVariables.set('tareaIdsInvertidasJson', JSON.stringify(ids.slice().reverse()));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              },
              {
                "key": "x-tenant-key",
                "value": "{{tenantKey}}",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tareas?establecimiento_id={{establecimientoId}}&ambito={{ambito}}&limit=200",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tareas"
              ],
              "query": [
                {
                  "key": "establecimiento_id",
                  "value": "{{establecimientoId}}"
                },
                {
                  "key": "ambito",
                  "value": "{{ambito}}"
                },
                {
                  "key": "limit",
                  "value": "200"
                }
              ]
            },
            "description": "Captura los ids de las tareas activas del tablero en tareaIdsJson y su inverso en tareaIdsInvertidasJson. Correr siempre antes de reordenar."
          }
        },
        {
          "name": "Reordenar tablero",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reordenado 1..N', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.be.an('array');",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const enviados = JSON.parse(pm.collectionVariables.get('tareaIdsInvertidasJson') || '[]');",
                  "if (enviados.length) {",
                  "  pm.test('El primero enviado quedo con orden 1', function () {",
                  "    const primera = (json.data || []).find(function (t) { return t.id === enviados[0]; });",
                  "    pm.expect(primera).to.not.eql(undefined);",
                  "    pm.expect(primera.orden).to.eql(1);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              },
              {
                "key": "x-tenant-key",
                "value": "{{tenantKey}}",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tareas/reordenar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tareas",
                "reordenar"
              ]
            },
            "description": "Requiere rol supervisor o admin_global. tarea_ids tiene que traer exactamente las tareas activas del tablero (pendiente y en_progreso), ni de mas, ni de menos, ni repetidas. Devuelve el tablero completo con orden reasignado 1..N.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"establecimiento_id\": \"{{establecimientoId}}\",\n  \"ambito\": \"{{ambito}}\",\n  \"tarea_ids\": {{tareaIdsInvertidasJson}}\n}"
            }
          }
        },
        {
          "name": "Reordenar con ids repetidos (debe fallar)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Conjunto invalido', function () {",
                  "  pm.response.to.have.status(422);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.error.code).to.eql('TAREA_REORDEN_INVALIDO');",
                  "  pm.expect(json.error.details).to.have.property('esperadas');",
                  "  pm.expect(json.error.details).to.have.property('recibidas');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
